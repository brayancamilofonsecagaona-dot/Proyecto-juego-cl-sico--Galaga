[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://Scenes/weapon.gd" id="1_w"]
[ext_resource type="PackedScene" path="res://Scenes/Bullet.tscn" id="2_b"]

[node name="Weapon" type="Node2D"]
